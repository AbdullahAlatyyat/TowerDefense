generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlserver"
  url      = env("DATABASE_URL")
}

model User {
  id           Int      @id @default(autoincrement())
  email           String   @unique
  passwordHash    String
  muted           Boolean  @default(false)
  currency        Int      @default(0)
  displayName     String   @default("")
  bestEndlessWave Int      @default(0)
  heroXp          Int      @default(0)
  createdAt       DateTime @default(now())

  sessions      Session[]
  levelProgress LevelProgress[]
  dailyResults  DailyResult[]
  achievements  UserAchievement[]
  metaUpgrades  MetaUpgrade[]
}

model Session {
  id        String   @id // sha256 hash of the opaque token, never the raw token
  userId    Int
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model LevelProgress {
  userId    Int
  levelId   String
  stars     Int
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, levelId])
}

model DailyResult {
  id        Int      @id @default(autoincrement())
  userId    Int
  date      String // YYYY-MM-DD
  won       Boolean
  livesLeft Int
  stars     Int
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date])
}

model UserAchievement {
  userId        Int
  achievementId String
  unlockedAt    DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, achievementId])
}

model MetaUpgrade {
  userId    Int
  upgradeId String
  tier      Int
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, upgradeId])
}
